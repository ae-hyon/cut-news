#!/usr/bin/env python3
"""Annoying Cap — 자동 뉴스 수집기
requires: pip install requests beautifulsoup4
"""

import re
import time
from datetime import datetime
from pathlib import Path
from urllib.parse import urlparse

import requests
from bs4 import BeautifulSoup

# 1. 언론사별 셀렉터 설정
CONTENT_SELECTORS = {
    'newsis.com':      ['#textBody p', '.view_txt p',             '.news_article_body p'],
    'mt.co.kr':        ['#textBody p', '.news_cnt_detail_wrap p', '#newsContents p'    ],
    'news1.kr':        ['.article-body p', '#article-body p',     '.news_body_wrap p'  ],
    'imnews.imbc.com': ['.news_body p', '.article_txt p',         '.view_con p'        ],
}
GENERIC_FALLBACK = ['article p', '[class*="article"] p', '[class*="content"] p', 'section p']

HEADERS = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36',
    'Accept-Language': 'ko-KR,ko;q=0.9,en-US;q=0.8',
}
OUTPUT_FILE = Path('news_summary.md')

ARTICLES = [
    {'index': 1, 'topic': '방시혁, 2000억 부당이득 혐의 구속영장 신청',      'url': 'https://www.newsis.com/view/NISX20260421_0003600696'},
    {'index': 2, 'topic': '뉴진스, 코펜하겐 포착…민지 합류 미정 컴백 임박',  'url': 'https://www.mt.co.kr/entertainment/2026/04/27/2026042714067299138'},
    {'index': 3, 'topic': '위너 송민호, 병역법 위반 징역 1년 6개월 구형',     'url': 'https://www.news1.kr/society/court-prosecution/6143557'},
    {'index': 4, 'topic': '어도어, 다니엘·민희진에 431억 손해배상 청구 소송', 'url': 'https://www.newsis.com/view/NISX20260325_0003563829'},
    {'index': 5, 'topic': '위너 송민호, 부실 복무 이유 묻자 즉답 회피 (현장)','url': 'https://imnews.imbc.com/news/2026/society/article/6816838_36918.html'},
]


# 2. 요약 함수 (나중에 AI API를 연결할 수 있는 자리)
def summarize_text(text):
    if not text:
        return '본문을 가져오지 못했습니다.'

    # TODO: 아래 주석을 해제하면 Claude API로 교체됩니다.
    # import anthropic
    # client = anthropic.Anthropic(api_key='YOUR_API_KEY')
    # msg = client.messages.create(
    #     model='claude-opus-4-7',
    #     max_tokens=100,
    #     messages=[{'role': 'user',
    #                'content': f'다음 뉴스 본문을 30자 이내로 핵심만 요약해줘:\n{text[:500]}'}]
    # )
    # return msg.content[0].text.strip()

    # 현재: 첫 문장 앞부분 30자 추출
    first_line = text.split('\n')[0].strip()
    sentence_match = re.search(r'^.{10,}?[.!?]', first_line)
    candidate = sentence_match.group(0) if sentence_match else first_line
    return candidate[:30].rstrip() + '...' if len(candidate) > 30 else candidate


# 3. 메인 크롤링 로직
def scrape_news(url):
    hostname = urlparse(url).hostname or ''
    hostname = hostname.removeprefix('www.')

    res = requests.get(url, headers=HEADERS, timeout=15)
    res.raise_for_status()
    res.encoding = res.apparent_encoding
    soup = BeautifulSoup(res.text, 'html.parser')

    # 제목 추출 (og:title 우선, 없으면 twitter:title, 없으면 h1)
    og_title = soup.find('meta', property='og:title')
    tw_title = soup.find('meta', attrs={'name': 'twitter:title'})
    h1_tag   = soup.find('h1')

    if og_title and og_title.get('content'):
        title = og_title['content'].strip()
    elif tw_title and tw_title.get('content'):
        title = tw_title['content'].strip()
    elif h1_tag:
        title = re.sub(r'\s+', ' ', h1_tag.get_text()).strip()
    else:
        title = '제목 없음'

    # 언론사 추출
    og_site = soup.find('meta', property='og:site_name')
    tw_site = soup.find('meta', attrs={'name': 'twitter:site'})

    if og_site and og_site.get('content'):
        media = og_site['content'].strip()
    elif tw_site and tw_site.get('content'):
        media = tw_site['content'].strip().lstrip('@')
    else:
        media = hostname

    # 본문 추출 (30자 미만 제외 로직)
    selectors = CONTENT_SELECTORS.get(hostname, []) + GENERIC_FALLBACK
    content = ''
    for sel in selectors:
        paras = [re.sub(r'\s+', ' ', p.get_text()).strip() for p in soup.select(sel)]
        paras = [t for t in paras if len(t) > 30]  # 광고·캡션 짧은 텍스트 제거
        if len(paras) >= 2:
            content = '\n'.join(paras)
            break

    return {
        'url':        url,
        'title':      title,
        'media':      media,
        'content':    content,
        'summary':    summarize_text(content),
        'scraped_at': datetime.now(),
    }


# 4. 파일 저장 로직 — 결과를 news_summary.md로 저장
def save_markdown(results):
    run_date = datetime.now().strftime('%Y년 %m월 %d일 %H:%M')
    lines = ['# Annoying Cap 뉴스 요약', '', f'> 실행 날짜: {run_date}', '', '---', '']

    for entry, article in results:
        body_preview = article['content'][:500].rstrip()
        if len(article['content']) > 500:
            body_preview += '…'
        lines += [
            f"## {entry['index']}. {article['title']}", '',
            f"- **언론사**: {article['media']}",
            f"- **요약**: {article['summary']}",
            f"- **URL**: {article['url']}", '',
            '### 본문', '', body_preview, '', '---', '',
        ]

    OUTPUT_FILE.write_text('\n'.join(lines), encoding='utf-8')
    print(f'\n결과 저장 완료: {OUTPUT_FILE.resolve()}')


# 5. 출력
def print_result(entry, article):
    line = '═' * 68
    print(f'\n{line}')
    print(f"[{entry['index']}/5] {entry['topic']}")
    print(line)
    print(f"  언론사  : {article['media']}")
    print(f"  제목    : {article['title']}")
    print(f"  요약    : {article['summary']}")
    print(f"  본문    : {article['content'][:200].rstrip()}…")
    print(f"  URL     : {article['url']}")
    print(f"  수집시각: {article['scraped_at'].isoformat()}")

def print_error(entry, err):
    print(f"\n[{entry['index']}/5] 실패: {entry['topic']}")
    print(f"  URL  : {entry['url']}")
    print(f'  오류 : {err}')


# 6. 진입점
def main():
    success = 0
    results = []
    print('뉴스 크롤링 시작 (총 5건)\n')

    for entry in ARTICLES:
        try:
            article = scrape_news(entry['url'])
            print_result(entry, article)
            results.append((entry, article))
            success += 1
        except Exception as err:
            print_error(entry, err)

        if entry['index'] < len(ARTICLES):
            time.sleep(1.5)

    print(f'\n{"─" * 68}')
    print(f'완료: {success} / {len(ARTICLES)}건 성공')
    if results:
        save_markdown(results)


if __name__ == '__main__':
    main()
