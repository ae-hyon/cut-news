import os
import re
import json
import csv
import time
import requests
from bs4 import BeautifulSoup
from datetime import datetime
from dotenv import load_dotenv

load_dotenv()

# ────────────────────────────────────────────
# 설정
# ────────────────────────────────────────────
QUERY = "사회"   # 검색어
COUNT = 20       # 수집할 기사 수 (최대 100)

CLIENT_ID     = os.getenv("NAVER_CLIENT_ID")
CLIENT_SECRET = os.getenv("NAVER_CLIENT_SECRET")

HEADERS = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'}

# news.naver.com 본문 셀렉터 (우선순위 순)
BODY_SELECTORS = ['#dic_area', '#articleBodyContents', '.go_trans._article_content']


# ────────────────────────────────────────────
# 1. Naver API로 기사 목록 가져오기
# ────────────────────────────────────────────
def get_article_list(query, count):
    print(f'[1단계] "{query}" 기사 목록 수집 중...')

    if not CLIENT_ID or not CLIENT_SECRET:
        raise EnvironmentError(".env 파일에 NAVER_CLIENT_ID / NAVER_CLIENT_SECRET 를 입력하세요.")

    res = requests.get(
        'https://openapi.naver.com/v1/search/news.json',
        headers={
            'X-Naver-Client-Id': CLIENT_ID,
            'X-Naver-Client-Secret': CLIENT_SECRET,
        },
        params={'query': query, 'display': count, 'sort': 'date'},
        timeout=10
    )
    res.raise_for_status()

    items = res.json().get('items', [])
    print(f'       → {len(items)}개 기사 목록 수신 완료\n')
    return items


# ────────────────────────────────────────────
# 2. 개별 기사 본문 스크래핑
# ────────────────────────────────────────────
def scrape_article(item):
    naver_link    = item.get('link', '')
    original_link = item.get('originallink') or naver_link

    # API가 반환하는 제목/설명의 HTML 태그 제거
    title       = BeautifulSoup(item.get('title', ''),       'html.parser').get_text()
    description = BeautifulSoup(item.get('description', ''), 'html.parser').get_text()

    # 날짜 포맷 변환: "Mon, 28 Apr 2026 10:00:00 +0900" → "2026-04-28 10:00"
    raw_date = item.get('pubDate', '')
    try:
        date = datetime.strptime(raw_date, '%a, %d %b %Y %H:%M:%S %z').strftime('%Y-%m-%d %H:%M')
    except Exception:
        date = raw_date

    # news.naver.com URL만 본문 스크래핑 가능
    body = ''
    if 'news.naver.com' in naver_link:
        try:
            res = requests.get(naver_link, headers=HEADERS, timeout=10)
            res.raise_for_status()
            soup = BeautifulSoup(res.text, 'html.parser')

            for selector in BODY_SELECTORS:
                el = soup.select_one(selector)
                if el:
                    # 광고·이미지 캡션 제거
                    for tag in el.select('span.end_photo_org, em'):
                        tag.decompose()
                    body = re.sub(r'\s{2,}', ' ', el.get_text(separator=' ')).strip()
                    break

            time.sleep(0.3)  # 서버 부하 방지
        except Exception as e:
            print(f'       ! 본문 수집 실패: {e}')

    return {
        '제목': title,
        '날짜': date,
        '본문': body or description,   # 본문 없으면 API 요약으로 대체
        '링크': original_link,
    }


# ────────────────────────────────────────────
# 3. 결과 저장 (JSON + CSV + Markdown)
# ────────────────────────────────────────────
def save_results(results, query):
    os.makedirs('output', exist_ok=True)
    timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
    prefix    = f'output/{query}_{timestamp}'

    # JSON
    with open(f'{prefix}.json', 'w', encoding='utf-8') as f:
        json.dump(results, f, ensure_ascii=False, indent=2)

    # CSV
    with open(f'{prefix}.csv', 'w', newline='', encoding='utf-8-sig') as f:
        writer = csv.DictWriter(f, fieldnames=['제목', '날짜', '본문', '링크'])
        writer.writeheader()
        writer.writerows(results)

    # Markdown 요약
    with open(f'{prefix}.md', 'w', encoding='utf-8') as f:
        f.write(f'# {query} 뉴스 요약 리포트\n\n')
        f.write(f'수집 일시: {datetime.now().strftime("%Y-%m-%d %H:%M")}\n\n')
        for i, r in enumerate(results, 1):
            summary = r['본문'][:50] + '...' if len(r['본문']) > 50 else r['본문']
            f.write(f"## {i}. {r['제목']}\n")
            f.write(f"- 날짜: {r['날짜']}\n")
            f.write(f"- 요약: {summary}\n")
            f.write(f"- URL: {r['링크']}\n\n")

    print(f'  JSON → {prefix}.json')
    print(f'  CSV  → {prefix}.csv')
    print(f'  MD   → {prefix}.md')


# ────────────────────────────────────────────
# 실행
# ────────────────────────────────────────────
if __name__ == '__main__':
    # 1단계: API로 기사 목록 수집
    items = get_article_list(QUERY, COUNT)

    # 2단계: 각 기사 스크래핑
    print(f'[2단계] 기사 본문 스크래핑 중...')
    results = []
    for i, item in enumerate(items, 1):
        article = scrape_article(item)
        status  = '본문 O' if len(article['본문']) > 100 else '요약만'
        print(f'  [{i:02d}/{COUNT}] {status} | {article["제목"][:40]}')
        results.append(article)

    # 3단계: 저장
    print(f'\n[3단계] 파일 저장 중...')
    save_results(results, QUERY)

    print(f'\n완료! 총 {len(results)}개 기사가 output/ 폴더에 저장되었습니다.')
