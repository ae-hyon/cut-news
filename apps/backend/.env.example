APP_ENV=development
APP_NAME=Annoying Cap Core Backend
APP_VERSION=0.1.0
API_PREFIX=/v1
DEBUG=true
DATABASE_ECHO=false
MIGRATE_ON_STARTUP=true
SEED_ON_STARTUP=true
# Local Docker Postgres default:
DATABASE_URL=postgresql+psycopg://annoyingcap:annoyingcap@localhost:54329/annoyingcap
# Optional Neon/external Postgres example. Prefer Neon pooled URLs for app runtime.
# Plain postgresql:// URLs from Neon are normalized to postgresql+psycopg:// by the backend.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
NEWS_SUMMARIZER_DIR=../summarizer
# Optional local pipeline diagnostic cap; positive values limit summarizer raw export count.
# Leave unset for product-like real-data pipeline runs.
# NEWS_PIPELINE_MAX_ARTICLES=8
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_REDIRECT_URI=http://127.0.0.1:8000/v1/auth/oauth/kakao/callback
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_TOKEN_URL=https://kauth.kakao.com/oauth/token
KAKAO_USERINFO_URL=https://kapi.kakao.com/v2/user/me
FRONTEND_APP_URL=http://127.0.0.1:3000
JWT_SECRET_KEY=change-this-local-dev-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
OAUTH_STATE_TTL_MINUTES=10
AUTH_ACCESS_COOKIE_NAME=annoyingcap_access_token
AUTH_REFRESH_COOKIE_NAME=annoyingcap_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
