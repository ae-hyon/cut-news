# Root Docker Compose / full news pipeline settings
# Copy to .env and fill credentials when using NEWS_SOURCE=naver-search.

# News source: seeded | naver-search
NEWS_SOURCE=seeded
NEWS_QUERY=경제
NEWS_COUNT=20

# Required only when NEWS_SOURCE=naver-search.
# These are consumed by crawler collection, including the news-scheduler full pipeline job.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Scheduler behavior
RUN_ON_STARTUP=false

# Frontend -> backend API URL used by the Dockerized Next app in browser code.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend CORS origins for browser E2E; include both common loopback hostnames.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Required for real Kakao login. Use the REST API key from Kakao Developers.
# The redirect URI must also be registered in the Kakao app settings.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:8000/v1/auth/oauth/kakao/callback

# Summarizer/pipeline execution
PIPELINE_LLM_BACKEND=codex_exec
PIPELINE_MODEL=gpt-5.4-mini
PIPELINE_CODEX_REASONING_EFFORT=low
PIPELINE_MAX_ATTEMPTS=2
PIPELINE_RETRY_DELAY_SECONDS=60
