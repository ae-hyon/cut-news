# Root Docker Compose / full news pipeline settings
# Copy to .env and fill credentials when using NEWS_SOURCE=naver-search or naver-all-categories.

# News source: seeded | naver-search | naver-all-categories
# Use naver-all-categories for the product category taxonomy crawl. In that mode NEWS_COUNT is per query.
NEWS_SOURCE=seeded
NEWS_QUERY=경제
NEWS_COUNT=20
# Optional diagnostic cap: positive values limit summarizer raw export count.
# Leave unset for product-like real-data pipeline runs.
# NEWS_PIPELINE_MAX_ARTICLES=8

# Required only when NEWS_SOURCE uses Naver.
# These are consumed by crawler collection, including the news-scheduler full pipeline job.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Scheduler behavior
RUN_ON_STARTUP=false

# Frontend -> backend API URL used by the Dockerized Next app in browser code.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8030

# Backend CORS origins for browser E2E; include both common loopback hostnames.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3030,http://localhost:3030

# Optional external Postgres for shared dev/staging DB. Neon is the recommended
# free managed option. Keep this commented for the default local Docker/SQLite DB.
# Use Neon pooled URLs for app runtime; plain postgresql:// URLs from Neon are
# normalized to postgresql+psycopg:// by the backend.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require

# Required for real Kakao login. Use the REST API key from Kakao Developers.
# The redirect URI must also be registered in the Kakao app settings.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:8030/v1/auth/oauth/kakao/callback

# Summarizer/pipeline execution
# Preferred path: run through Hermes-managed OpenAI Codex OAuth instead of raw codex exec.
PIPELINE_LLM_BACKEND=hermes_cli
PIPELINE_HERMES_PROFILE=cut-news-pipeline
PIPELINE_HERMES_PROVIDER=openai-codex
PIPELINE_HERMES_MODEL=gpt-5.5
# Optional Hermes reasoning effort: minimal | low | medium | high | xhigh. Leave blank for profile default.
PIPELINE_HERMES_REASONING_EFFORT=medium
# Legacy direct Codex CLI fallback only; avoid unless Codex OAuth is healthy.
PIPELINE_MODEL=gpt-5.4-mini
PIPELINE_CODEX_REASONING_EFFORT=low
PIPELINE_MAX_ATTEMPTS=2
PIPELINE_RETRY_DELAY_SECONDS=60
