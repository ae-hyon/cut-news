# Root Docker Compose / full news pipeline settings
# Copy to .env and fill credentials when using NEWS_SOURCE=naver-search.

# News source: seeded | naver-search
NEWS_SOURCE=seeded
NEWS_QUERY=경제
NEWS_COUNT=20

# Required only when NEWS_SOURCE=naver-search.
# These are consumed by crawler collection, including the news-scheduler full pipeline job.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Scheduler behavior
RUN_ON_STARTUP=false

# Summarizer/pipeline execution
PIPELINE_LLM_BACKEND=codex_exec
PIPELINE_MODEL=gpt-5.4-mini
PIPELINE_CODEX_REASONING_EFFORT=low
PIPELINE_MAX_ATTEMPTS=2
PIPELINE_RETRY_DELAY_SECONDS=60
